INBOX_BASE_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000
UPLOAD_TTL_SECONDS=3600
MAX_UPLOAD_BYTES=10485760

# Outbound submission email. Copy this file to backend/.env for local use.
APP_ENV=development
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_TIMEOUT_SECONDS=15
EMAIL_FROM_ADDRESS=
EMAIL_API_BASE_URL=https://api.resend.com
EMAIL_API_KEY=
# Required in production and shared only with the Next.js server proxy.
OUTBOUND_EMAIL_AUTH_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_EMAIL=proshipping.demo@gmail.com
SMTP_USERNAME=proshipping.demo@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_USE_TLS=1
SUPERVISOR_EMAIL=joelchong0o00o0@gmail.com
# Optional comma-separated destinations that a supervisor draft may be changed to.
SUPERVISOR_ALLOWED_RECIPIENTS=
# Optional safety override: sender addresses remain visible, but mail is delivered here.
DEMO_EMAIL_RECIPIENT=joelchong0o00o0@gmail.com

# Optional scanned/image-only PDF fallback. Keep disabled unless a Groq key is configured.
AI_ENABLED=0
SEMANTIC_AI_ENABLED=0
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
